@model SoundMoney.Models.StockDetailsViewModel
@{
    ViewData["Title"] = $"{Model.Symbol} - Deep Analysis";

    var peInd = Model.GetPeIndication();
    var pbInd = Model.GetPbIndication();
    var evInd = Model.GetEvEbitdaIndication();
    var pegInd = Model.GetPegIndication();
    var betaInd = Model.GetBetaIndication();
    var cccInd = Model.GetCashConversionCycleIndication();
    var debtInd = Model.GetDebtToEquityIndication();
    var debtEbitdaInd = Model.GetDebtToEbitdaIndication();
    var coverageInd = Model.GetInterestCoverageIndication();
    var currentRatioInd = Model.GetCurrentRatioIndication();
    var roeInd = Model.GetRoeIndication();
    var roicInd = Model.GetRoicIndication();
    var opmInd = Model.GetOperatingMarginIndication();
    var sloanInd = Model.GetSloanRatioIndication();
    var fcfConvInd = Model.GetFcfConversionIndication();
    var payoutInd = Model.GetDividendPayoutIndication();
    var altmanInd = Model.GetAltmanZIndication();
    var piotroskiInd = Model.GetPiotroskiIndication();
    var mScoreInd = Model.GetMScoreIndication();
    var marginInd = Model.GetNetProfitMarginIndication();
    var pledgeInd = Model.GetPromoterPledgeIndication();
}

<style>
    .extra-small {
        font-size: 0.8rem !important;
    }

    .metric-card {
        background-color: #f8f9fa;
        border-radius: 0.5rem;
        padding: 0.75rem;
    }

    .badge-sm {
        font-size: 0.7rem;
        padding: 0.2rem 0.45rem;
        font-weight: 500;
    }

    .text-info {
        color: #0dcaf0 !important;
        font-weight: 600;
        font-size: 0.85rem;
        opacity: 0.7;
    }

        .text-info:hover {
            opacity: 1;
        }
</style>

<div class="container-fluid px-2 px-md-4 py-3">
    <!-- Navigation Back Button -->
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            &larr; Back to Screener
        </a>
    </div>

    <!-- 1. Basic Stock Information Header -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-dark text-white font-monospace fs-6">@Model.Symbol</span>
                        <span class="badge bg-light text-secondary border">@Model.Sector</span>
                    </div>
                    <h3 class="fw-bold mb-1">@Model.CompanyName</h3>
                    <p class="text-muted extra-small font-monospace mb-0">
                        Last Analyzed: @(Model.LastAnalyzed.HasValue ? Model.LastAnalyzed.Value.ToString("dd MMM yyyy HH:mm") : "N/A")
                    </p>
                </div>

                <div class="text-md-end">
                    <span class="text-muted small d-block">Current Market Price</span>
                    <h2 class="fw-bold text-primary mb-0">₹@Model.CurrentPrice.ToString("N2")</h2>
                </div>
            </div>

            <!-- Company snapshot: simple facts to anchor the ratios below, not "good or bad" on their own -->
            <div class="row g-2 mt-3 pt-3 border-top text-center text-md-start">
                <div class="col-6 col-md-3">
                    <span class="text-muted extra-small d-block">Market Cap</span>
                    <strong>₹@Model.MarketCapCr.ToString("N0") Cr</strong>
                    <div class="extra-small text-muted">Total value of the whole company</div>
                </div>
                <div class="col-6 col-md-3">
                    <span class="text-muted extra-small d-block">EPS (Earnings/Share)</span>
                    <strong>₹@Model.Eps.ToString("N2")</strong>
                    <div class="extra-small text-muted">Actual profit earned per share this year</div>
                </div>
                <div class="col-6 col-md-3">
                    <span class="text-muted extra-small d-block">Book Value/Share</span>
                    <strong>₹@Model.BookValuePerShareAmount.ToString("N2")</strong>
                    <div class="extra-small text-muted">Accounting net worth behind each share</div>
                </div>
                <div class="col-6 col-md-3">
                    <span class="text-muted extra-small d-block">Face Value</span>
                    <strong>₹@Model.FaceValue.ToString("N2")</strong>
                    <div class="extra-small text-muted">Original nominal value of one share</div>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. Core Valuation Output & Safety Summary -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0">Valuation Verdict & Sound Score</h5>
        </div>
        <div class="card-body p-3 p-md-4 pt-0">
            <div class="row g-3">
                <div class="col-12 col-sm-6 col-md-3">
                    <div class="metric-card text-center border">
                        <span class="text-muted d-block small">Intrinsic Value</span>
                        <h4 class="fw-bold text-dark mb-0">₹@Model.IntrinsicValue.ToString("N2")</h4>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <div class="metric-card text-center border">
                        <span class="text-muted d-block small">Margin of Safety</span>
                        <h4 class="fw-bold mb-0 @(Model.MarginOfSafetyPercent >= 0 ? "text-success" : "text-danger")">
                            @Model.MarginOfSafetyPercent.ToString("N2")%
                        </h4>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <div class="metric-card text-center border">
                        <span class="text-muted d-block small">Valuation Verdict</span>
                        <span class="badge fs-6 mt-1 @(Model.Verdict == "Undervalued" ? "bg-success" : Model.Verdict == "Overvalued" ? "bg-danger" : "bg-warning text-dark")">
                            @Model.Verdict
                        </span>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-md-3">
                    <div class="metric-card text-center border">
                        <span class="text-muted d-block small">Sound Score Rating</span>
                        <span class="badge fs-6 mt-1 @(Model.SoundScoreRating == "STRONG SOUND" || Model.SoundScoreRating == "SOUND" ? "bg-primary" : "bg-secondary")">
                            @Model.SoundScoreRating
                        </span>
                        <div class="extra-small text-muted mt-1">Score: @Model.SoundScore / 100</div>
                        @if (Model.IsScoreCapped)
                        {
                            <div class="extra-small text-warning-emphasis mt-1">Held down from @Model.SoundScoreRaw because: @string.Join("; ", Model.ScoreCapReasons)</div>
                        }
                    </div>
                </div>
            </div>

            <!-- How this valuation was actually worked out -->
            <div class="row g-3 mt-1">
                <div class="col-12 col-md-6">
                    <div class="p-2 border rounded bg-light">
                        <span class="small fw-bold text-muted">Main method used: <span class="text-dark">@Model.PrimaryMethod</span></span>
                        <div class="extra-small text-muted mt-1">@Model.GetMethodExplanation(Model.PrimaryMethod)</div>
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <div class="p-2 border rounded bg-light">
                        <span class="small fw-bold text-muted">Cross-checked with: <span class="text-dark">@Model.SecondaryMethod</span></span>
                        <div class="extra-small text-muted mt-1">@Model.GetMethodExplanation(Model.SecondaryMethod)</div>
                    </div>
                </div>
            </div>

            <!-- Concrete entry/exit price levels, straight from the Verdict's own thresholds -->
            <div class="row g-2 mt-1">
                <div class="col-12">
                    <div class="p-2 p-md-3 border rounded">
                        <span class="small fw-bold text-muted d-block mb-2">When would you actually buy or sell this, in rupees?</span>
                        <div class="row text-center g-2">
                            <div class="col-4">
                                <span class="badge bg-success mb-1">Buy Zone</span>
                                <div class="fw-bold">₹@Model.StrongBuyBelowPrice.ToString("N2")</div>
                                <div class="extra-small text-muted">Attractive entry price - a genuine margin of safety at this level</div>
                            </div>
                            <div class="col-4">
                                <span class="badge bg-info text-dark mb-1">Fair Value</span>
                                <div class="fw-bold">₹@Model.IntrinsicValue.ToString("N2")</div>
                                <div class="extra-small text-muted">What the company is estimated to actually be worth per share</div>
                            </div>
                            <div class="col-4">
                                <span class="badge bg-danger mb-1">Sell Zone</span>
                                <div class="fw-bold">₹@Model.SellAbovePrice.ToString("N2")</div>
                                <div class="extra-small text-muted">Above this, the price has run well ahead of estimated value</div>
                            </div>
                        </div>
                        <div class="extra-small text-muted mt-2">These are the exact same price breakpoints that decide the Verdict above (Strong Buy / Buy / Hold / Overvalued) - shown here as real prices instead of just a label, so it's clear what would need to change for the Verdict to change too.</div>
                    </div>
                </div>
            </div>

            <!-- Health & Safety Quick Bar -->
            <div class="row g-3 mt-1">
                <div class="col-12 col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small fw-bold text-muted">Altman Z-Score (Solvency Risk):</span>
                            <div class="d-flex align-items-center gap-2">
                                @if (Model.IsFinancialSector)
                                {
                                    <span class="fw-bold text-muted">N/A</span>
                                }
                                else
                                {
                                    <span class="fw-bold">@Model.AltmanZScore.ToString("N2")</span>
                                }
                                <span class="badge badge-sm @altmanInd.CssClass">@altmanInd.Label</span>
                            </div>
                        </div>
                        <div class="extra-small text-muted mt-1">
                            @if (Model.IsFinancialSector)
                            {
                                <text>This check doesn't apply to banks/NBFCs, whose balance sheets work differently from typical businesses.</text>
                            }
                            else
                            {
                                <text>In plain terms: how likely this company is to run into serious financial trouble in the next couple of years.</text>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small fw-bold text-muted">Piotroski F-Score (Financial Strength):</span>
                            <div class="d-flex align-items-center gap-2">
                                @if (Model.IsFinancialSector)
                                {
                                    <span class="fw-bold text-muted">N/A</span>
                                }
                                else
                                {
                                    <span class="fw-bold">@Model.PiotroskiFScore / 9</span>
                                }
                                <span class="badge badge-sm @piotroskiInd.CssClass">@piotroskiInd.Label</span>
                            </div>
                        </div>
                        <div class="extra-small text-muted mt-1">
                            @if (Model.IsFinancialSector)
                            {
                                <text>This checklist doesn't apply to banks/NBFCs, whose balance sheets work differently from typical businesses.</text>
                            }
                            else
                            {
                                <text>In plain terms: a 9-point checklist of the company's finances (profit, debt, efficiency) - higher out of 9 is healthier.</text>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="p-2 border rounded bg-light">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="small fw-bold text-muted">M-Score (Earnings Manipulation Risk):</span>
                            <div class="d-flex align-items-center gap-2">
                                @if (Model.IsFinancialSector)
                                {
                                    <span class="fw-bold text-muted">N/A</span>
                                }
                                else
                                {
                                    <span class="fw-bold">@Model.MScore.ToString("N2")</span>
                                }
                                <span class="badge badge-sm @mScoreInd.CssClass">@mScoreInd.Label</span>
                            </div>
                        </div>
                        <div class="extra-small text-muted mt-1">
                            @if (Model.IsFinancialSector)
                            {
                                <text>This check doesn't apply to banks/NBFCs, whose balance sheets work differently from typical businesses.</text>
                            }
                            else
                            {
                                <text>In plain terms: checks whether the reported profit looks genuine, or whether the numbers may be dressed up to look better than the underlying business really is.</text>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 3. Detailed Financial Indicators with Qualitative Indications -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3 border-0">
            <h5 class="fw-bold mb-0">Financial Indicators & Safety Ratings</h5>
        </div>
        <div class="card-body p-3 p-md-4 pt-0">
            <div class="row g-4">

                <!-- Valuation Multiples -->
                <div class="col-12 col-md-6 col-lg-3">
                    <h6 class="fw-bold text-muted small text-uppercase mb-3">Valuation Multiples</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                P/E Ratio
                                <div class="extra-small text-muted">Years of current profit to earn back the share price</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <strong>@Model.PE.ToString("N2")</strong>
                                <span class="badge badge-sm ms-1 @peInd.CssClass">@peInd.Label</span>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                P/B Ratio
                                <div class="extra-small text-muted">Multiple of the company's accounting net worth you're paying</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <strong>@Model.PB.ToString("N2")</strong>
                                <span class="badge badge-sm ms-1 @pbInd.CssClass">@pbInd.Label</span>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                EV / EBITDA
                                <div class="extra-small text-muted">Years of core operating profit to buy the whole company, debt included</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <strong>@Model.EvToEbitda.ToString("N2")</strong>
                                <span class="badge badge-sm ms-1 @evInd.CssClass">@evInd.Label</span>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                PEG Ratio
                                <div class="extra-small text-muted">Whether the price is reasonable given how fast profit is actually growing</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <strong>@Model.PegRatio.ToString("N2")</strong>
                                <span class="badge badge-sm ms-1 @pegInd.CssClass">@pegInd.Label</span>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                Beta
                                <div class="extra-small text-muted">How much the stock swings compared to the overall market</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <strong>@Model.Beta.ToString("N2")</strong>
                                <span class="badge badge-sm ms-1 @betaInd.CssClass">@betaInd.Label</span>
                            </div>
                        </li>
                    </ul>
                </div>

                <!-- Profitability Metrics -->
                <div class="col-12 col-md-6 col-lg-3">
                    <h6 class="fw-bold text-muted small text-uppercase mb-3">Profitability</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                ROE
                                @if (!string.IsNullOrEmpty(Model.RoeTrend))
                                {
                                    <span class="badge badge-sm ms-1 @(Model.RoeTrend == "Improving" ? "bg-success" : Model.RoeTrend == "Declining" ? "bg-danger" : "bg-secondary")">
                                        @(Model.RoeTrend == "Improving" ? "↑" : Model.RoeTrend == "Declining" ? "↓" : "→")
                                    </span>
                                }
                                <div class="extra-small text-muted">Profit earned per ₹100 shareholders have invested</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <strong>@Model.ROEPercent.ToString("N2")%</strong>
                                <span class="badge badge-sm ms-1 @roeInd.CssClass">@roeInd.Label</span>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                ROCE
                                @if (!string.IsNullOrEmpty(Model.RoceTrend))
                                {
                                    <span class="badge badge-sm ms-1 @(Model.RoceTrend == "Improving" ? "bg-success" : Model.RoceTrend == "Declining" ? "bg-danger" : "bg-secondary")">
                                        @(Model.RoceTrend == "Improving" ? "↑" : Model.RoceTrend == "Declining" ? "↓" : "→")
                                    </span>
                                }
                                <div class="extra-small text-muted">Profit earned per ₹100 of total capital used (own + borrowed money)</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <strong>@Model.ROCEPercent.ToString("N2")%</strong>
                                <span class="badge badge-sm ms-1 @(Model.ROCEPercent >= 15.0m ? "bg-success" : "bg-secondary")">
                                    @(Model.ROCEPercent >= 15.0m ? "Strong" : "Moderate")
                                </span>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                ROIC
                                <div class="extra-small text-muted">Return on ALL money invested in the business - a sign of a real competitive edge</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <strong>@Model.ROICPercent.ToString("N2")%</strong>
                                <span class="badge badge-sm ms-1 @roicInd.CssClass">@roicInd.Label</span>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                Operating Margin
                                <div class="extra-small text-muted">Core operating profit per ₹100 of sales, before interest, tax or one-offs</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <strong>@Model.OperatingProfitMarginPercent.ToString("N2")%</strong>
                                <span class="badge badge-sm ms-1 @opmInd.CssClass">@opmInd.Label</span>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                Net Profit Margin
                                <div class="extra-small text-muted">Rupees of real profit kept per ₹100 of sales</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <strong>@Model.NetProfitMarginPercent.ToString("N2")%</strong>
                                <span class="badge badge-sm ms-1 @marginInd.CssClass">@marginInd.Label</span>
                            </div>
                        </li>
                    </ul>
                </div>


                <!-- Financial Health & Debt Risk -->
                <div class="col-12 col-md-6 col-lg-3">
                    <h6 class="fw-bold text-muted small text-uppercase mb-3">Health & Debt Risk</h6>
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                Debt to Equity
                                <div class="extra-small text-muted">How much is borrowed vs. what shareholders put in - lower is safer</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <strong>@Model.DebtToEquity.ToString("N2")</strong>
                                <span class="badge badge-sm ms-1 @debtInd.CssClass">@debtInd.Label</span>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                Debt / EBITDA
                                <div class="extra-small text-muted">Years of core profit needed to pay off all debt (negative = more cash than debt)</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <strong>@Model.DebtToEbitda.ToString("N2")x</strong>
                                <span class="badge badge-sm ms-1 @debtEbitdaInd.CssClass">@debtEbitdaInd.Label</span>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                Interest Coverage
                                <div class="extra-small text-muted">
                                    @if (Model.IsFinancialSector)
                                    {
                                        <text>Doesn't apply to banks/NBFCs - lending IS the business, not debt to service</text>
                                    }
                                    else
                                    {
                                        <text>Times over the company can pay its yearly interest bill from profit</text>
                                    }
                                </div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                @if (Model.IsFinancialSector)
                                {
                                    <strong class="text-muted">N/A</strong>
                                }
                                else
                                {
                                    <strong>@Model.InterestCoverageRatio.ToString("N2")x</strong>
                                }
                                <span class="badge badge-sm ms-1 @coverageInd.CssClass">@coverageInd.Label</span>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                Current Ratio
                                <div class="extra-small text-muted">Whether short-term assets can cover bills due within a year</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <strong>@Model.CurrentRatio.ToString("N2")</strong>
                                <span class="badge badge-sm ms-1 @currentRatioInd.CssClass">@currentRatioInd.Label</span>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                Earnings Quality (Sloan Ratio)
                                <div class="extra-small text-muted">Checks if profit is real cash or mostly accounting entries - lower is better</div>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <strong>@Model.SloanRatio.ToString("N2")%</strong>
                                <span class="badge badge-sm ms-1 @sloanInd.CssClass">@sloanInd.Label</span>
                            </div>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                Promoter Holding
                                @if (!string.IsNullOrEmpty(Model.PromoterHoldingTrend))
                                {
                                    <span class="badge badge-sm ms-1 @(Model.PromoterHoldingTrend == "Improving" ? "bg-success" : Model.PromoterHoldingTrend == "Declining" ? "bg-danger" : "bg-secondary")">
                                        @(Model.PromoterHoldingTrend == "Improving" ? "↑" : Model.PromoterHoldingTrend == "Declining" ? "↓" : "→")
                                    </span>
                                }
                                <div class="extra-small text-muted">Share of the company still owned by founders/promoters</div>
                            </div>
                            <strong>@Model.PromoterHoldingPercent.ToString("N2")%</strong>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-start px-0 py-2">
                            <div class="text-muted small">
                                Promoter Pledge
