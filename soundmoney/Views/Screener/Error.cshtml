@{
    ViewData["Title"] = "Error";
}

<div class="container my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-12 col-md-6">
            <div class="card border-0 shadow-sm p-4">
                <div class="card-body">
                    <div class="text-danger mb-3">
                        <i class="bi bi-exclamation-triangle display-1"></i>
                    </div>
                    <h1 class="h3 text-danger fw-bold">Something went wrong</h1>
                    <p class="text-muted my-3">An unexpected error occurred while processing your request. Please try again or check application logs for details.</p>
                    <a href="/" class="btn btn-outline-primary btn-sm">Return to Screener</a>
                </div>
            </div>
        </div>
    </div>
</div>