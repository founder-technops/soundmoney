@model SoundMoney.Models.ScreenerViewModel
@{
    ViewData["Title"] = "Screener";
}

<form method="get" class="row g-3 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label">Min. Margin of Safety (%)</label>
        <input type="number" name="minMarginOfSafety" value="@Model.MinMarginOfSafety" class="form-control" step="1" />
    </div>
    <div class="col-auto">
        <label class="form-label">Sector</label>
        <select name="sector" class="form-select">
            <option value="">All sectors</option>
            @foreach (var s in Enum.GetValues<SoundMoney.Models.SectorCategory>())
            {
                <option value="@s" selected="@(Model.SelectedSector == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label">Score</label>
        <select name="score" class="form-select">
            <option value="">All</option>
            @foreach (var s in new List<string>() { "STRONG SOUND", "SOUND", "NEUTRAL", "UNSOUND" })
            {
                <option value="@s" selected="@(Model.SelectedScore == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Run screen</button>
    </div>
</form>

@if (!Model.Results.Any())
{
    <div class="alert alert-info">
        No stocks matched. This can mean either nothing clears your margin-of-safety
        threshold right now.
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Symbol</th>
                <th>Company</th>
                <th>Sector</th>
                <th class="text-end">Current Price (₹)</th>
                <th class="text-end">Intrinsic Value (₹)</th>
                <th class="text-end">Margin of Safety</th>
                <th>Verdict</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Results)
            {
                <tr>
                    <td><strong>@row.Symbol</strong></td>
                    <td>@row.CompanyName</td>
                    <td>@row.Sector</td>
                    <td class="text-end">@row.CurrentPrice.ToString("N2")</td>
                    <td class="text-end">@row.IntrinsicValue.ToString("N2")</td>
                    <td class="text-end">@row.MarginOfSafetyPercent.ToString("N2")%</td>
                    <td>
                        <span class="badge @(row.Verdict == "Undervalued" ? "bg-success" : row.Verdict == "Overvalued" ? "bg-danger" : "bg-secondary")">
                            @row.Verdict
                        </span>
                        <span class="badge @(row.Verdict == "Undervalued" ? "bg-success" : row.Verdict == "Overvalued" ? "bg-danger" : "bg-secondary")">
                            @row.SoundScoreRating
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="text-muted small">
    Intrinsic value is calculated dynamically using sector-specific valuation models, applying a justified Price-to-Book or Excess Returns approach for financial institutions and cash-flow or growth-adjusted models like Owner Earnings, DCF, and relative multiples for non-financial sectors like IT. The Margin of Safety is calculated as $((\text{Intrinsic Value} - \text{Current Price}) / \text{Current Price}) \times 100\%$. Designed strictly for educational and screening purposes, this tool does not constitute investment advice—always verify scraped financial inputs and consult with SEBI-registered financial advisors before making any investment decisions.
</p>
