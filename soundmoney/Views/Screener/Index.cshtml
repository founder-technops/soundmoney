@model SoundMoney.Models.ScreenerViewModel
@{
    ViewData["Title"] = "SoundMoney";
}

<style>
    
</style>

<div class="container-fluid px-2 px-md-4 py-3">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 gap-2">
        <div>
            <h3 class="h4 fw-bold mb-1">Screener</h3>
            <p class="text-muted small mb-0">Screen stocks based on margin of safety and fundamentals.</p>
        </div>
    </div>

    <!-- Filter Form -->
    <div class="card border-0 shadow-sm mb-4 bg-light">
        <div class="card-body p-3">
            <form method="get" class="row g-2 g-md-3 align-items-end">
                <div class="col-12 col-sm-6 col-md-4">
                    <label class="form-label small text-muted font-weight-bold">Search Symbol or Company</label>
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control form-control-sm" placeholder="e.g. INFY, TCS, Wipro..." />
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small text-muted font-weight-bold">Min. Margin of Safety (%)</label>
                    <input type="number" name="minMarginOfSafety" value="@Model.MinMarginOfSafety" class="form-control form-control-sm" step="1" />
                </div>

                <!-- Score Filter Dropdown -->
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small text-muted font-weight-bold d-block">Score Filter</label>
                    <details class="custom-multi-select position-relative">
                        <summary class="btn btn-white border bg-white text-start text-truncate btn-sm d-flex justify-content-between align-items-center w-100">
                            <span id="scoreDropdownLabel">
                                @(Model.SelectedScores != null && Model.SelectedScores.Any()
                                                                ? string.Join(", ", Model.SelectedScores)
                                                                : "All scores")
                            </span>
                            <span class="ms-2 text-muted small">▼</span>
                        </summary>
                        <div class="card border shadow-sm p-2 position-absolute start-0 w-100 mt-1 bg-white" style="z-index: 1050; max-height: 200px; overflow-y: auto;">
                            @foreach (var s in new List<string>() { "STRONG SOUND", "SOUND", "NEUTRAL", "UNSOUND" })
                            {
                                bool isChecked = Model.SelectedScores != null && Model.SelectedScores.Contains(s);
                                <div class="form-check my-1">
                                    <input class="form-check-input score-checkbox"
                                           type="checkbox"
                                           name="scores"
                                           value="@s"
                                           id="score_@s.Replace(" ", "_")"
                                           @(isChecked ? "checked" : "") />
                                    <label class="form-check-label small w-100 cursor-pointer" for="score_@s.Replace(" ", "_")">
                                        @s
                                    </label>
                                </div>
                            }
                        </div>
                    </details>
                </div>

                <div class="col-12 col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary btn-sm">Run Screen</button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Results.Any())
    {
        <div class="alert alert-info border-0 shadow-sm">
            No stocks matched your search criteria. Try adjusting your search parameters.
        </div>
    }
    else
    {
        <!-- DESKTOP VIEW (Rounded Rectangle Table Rows with Last Analyzed Column) -->
        <div class="d-none d-md-block mb-4">
            <div class="table-responsive">
                <table class="table table-borderless align-middle table-rounded-rows mb-0">
                    <thead class="text-secondary small text-uppercase">
                        <tr>
                            <th class="ps-3">Symbol</th>
                            <th>Company</th>
                            <th>Sector</th>
                            <th class="text-end">Current Price (₹)</th>
                            <th class="text-end">Intrinsic Value (₹)</th>
                            <th class="text-end">Div. Yield</th>
                            <th class="text-center">Div. Consistency</th>
                            <th class="text-end">Margin of Safety</th>
                            <th class="text-center">Last Analyzed</th>
                            <th class="text-center pe-3">Verdict</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Results)
                        {
                            <tr>
                                <td class="ps-3">
                                    <span class="badge bg-light text-dark border font-monospace fs-6">@row.Symbol</span>
                                </td>
                                <td class="fw-semibold text-dark">@row.CompanyName</td>
                                <td>
                                    <span class="badge bg-light text-secondary border fw-normal">@row.Sector</span>
                                </td>
                                <td class="text-end font-monospace">₹@row.CurrentPrice.ToString("N2")</td>
                                <td class="text-end font-monospace">₹@row.IntrinsicValue.ToString("N2")</td>

                                <!-- Dividend Yield Column -->
                                <td class="text-end font-monospace">
                                    @row.DividendYieldPercent.ToString("N2")%
                                </td>

                                <!-- Dividend Consistency Column -->
                                <td class="text-center">
                                    @if (row.IsDividendConsistent)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">Consistent</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted border">Inconsistent</span>
                                    }
                                </td>

                                <td class="text-end font-monospace fw-bold @(row.MarginOfSafetyPercent >= 0 ? "text-success" : "text-danger")">
                                    @row.MarginOfSafetyPercent.ToString("N2")%
                                </td>
                                <td class="text-center small font-monospace text-muted">
                                    @(row.LastAnalyzed.HasValue? row.LastAnalyzed.Value.ToString("dd MMM yyyy") : "N/A")
                                </td>
                                <td class="text-center pe-3">
                                    <span class="badge @(row.Verdict == "Undervalued" ? "bg-success" : row.Verdict == "Overvalued" ? "bg-danger" : "bg-secondary") me-1">
                                        @row.Verdict
                                    </span>
                                    <span class="badge bg-primary">
                                        @row.SoundScoreRating
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- MOBILE VIEW (Cards with Last Analyzed Date) -->
        <div class="d-md-none row g-3 mb-4">
            @foreach (var row in Model.Results)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge bg-light text-dark border font-monospace fs-6 me-1">@row.Symbol</span>
                                </div>
                                <div>
                                    <span class="badge @(row.Verdict == "Undervalued" ? "bg-success" : row.Verdict == "Overvalued" ? "bg-danger" : "bg-secondary")">
                                        @row.Verdict
                                    </span>
                                    <span class="badge bg-primary">
                                        @row.SoundScoreRating
                                    </span>
                                </div>
                            </div>

                            <h6 class="fw-bold mb-1">@row.CompanyName</h6>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="badge bg-light text-secondary border fw-normal small">@row.Sector</span>
                                <span class="text-muted extra-small font-monospace">
                                    Analyzed: @(row.LastAnalyzed.HasValue? row.LastAnalyzed.Value.ToString("dd MMM yyyy") : "N/A")
                                </span>
                            </div>

                            <div class="row g-2 text-center bg-light p-2 rounded mb-2 font-monospace small">
                                <div class="col-3 border-end">
                                    <span class="text-muted d-block extra-small">Price</span>
                                    <strong>₹@row.CurrentPrice.ToString("N2")</strong>
                                </div>
                                <div class="col-3 border-end">
                                    <span class="text-muted d-block extra-small">Intrinsic</span>
                                    <strong>₹@row.IntrinsicValue.ToString("N2")</strong>
                                </div>
                                <div class="col-3 border-end">
                                    <span class="text-muted d-block extra-small">Div. Yield</span>
                                    <strong>@row.DividendYieldPercent.ToString("N2")%</strong>
                                </div>
                                <div class="col-3">
                                    <span class="text-muted d-block extra-small">MoS</span>
                                    <strong class="@(row.MarginOfSafetyPercent >= 0 ? "text-success" : "text-danger")">
                                        @row.MarginOfSafetyPercent.ToString("N2")%
                                    </strong>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between align-items-center px-1 mb-1">
                                <span class="text-muted small">Dividend Consistency:</span>
                                @if (row.IsDividendConsistent)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Consistent</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Inconsistent</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Methodology Disclosure -->
    <div class="card border-0 bg-light p-3">
        <p class="text-muted small mb-2">
            <strong>Methodology & Disclaimer:</strong> Intrinsic value is calculated dynamically using sector-specific valuation models, applying a justified Price-to-Book or Excess Returns approach for financial institutions and cash-flow or growth-adjusted models like Owner Earnings, DCF, and relative multiples for non-financial sectors.
        </p>

        <!-- Formula Wrapper -->
        <div class="d-flex align-items-center flex-wrap my-2 p-2 bg-white rounded border font-monospace text-dark small" style="line-height: 1.2;">
            <span class="fw-bold me-2">Margin of Safety % =</span>
            <div class="d-inline-flex align-items-center me-2">
                <span class="fs-4 fw-light me-1">(</span>
                <div class="d-inline-flex flex-column text-center px-1">
                    <span class="border-bottom border-dark pb-1 mb-1">Intrinsic Value - Current Price</span>
                    <span>Current Price</span>
                </div>
                <span class="fs-4 fw-light ms-1">)</span>
            </div>
            <span class="fw-bold">× 100%</span>
        </div>

        <p class="text-muted small mb-0">
            Designed strictly for educational and screening purposes—always verify inputs before making investment decisions.
        </p>
    </div>
</div>