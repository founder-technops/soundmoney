@* Views/Screener/Index.cshtml *@
@model SoundMoney.Models.ScreenerViewModel

<div class="container-fluid mt-4">
    <h2 class="mb-4 text-primary fw-bold">🪙 Sound Money Stock Screener</h2>

    <div class="row">
        <!-- Sidebar Filter Pane: Stacked on mobile, side-by-side on desktop -->
        <div class="col-12 col-md-3 mb-4">
            <div class="card shadow-sm border-0 bg-light p-3">
                <h5 class="card-title fw-bold text-secondary mb-3">Filters</h5>
                <form asp-action="Index" method="post">

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Sector</label>
                        <select asp-for="SelectedSector" class="form-select" asp-items="@(new SelectList(Model.Sectors))">
                            <option value="">All Sectors</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Min Price</label>
                        <input asp-for="MinPrice" type="number" step="0.1" class="form-control" placeholder="e.g. 15" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Max Price</label>
                        <input asp-for="MaxPrice" type="number" step="0.1" class="form-control" placeholder="e.g. 30" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Min Margin of safety</label>
                        <input asp-for="MinMOS" type="number" class="form-control" placeholder="e.g. 20" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">Max Margin of safety</label>
                        <input asp-for="MaxMOS" type="number" class="form-control" placeholder="e.g. 40" />
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold shadow-sm">Apply Filters</button>
                </form>
            </div>
        </div>

        <!-- Dynamic Results Pane -->
        <div class="col-12 col-md-9">
            <div class="card shadow-sm border-0 p-3">
                <h5 class="fw-bold text-secondary mb-3">Results (@Model.Results.Count)</h5>

                <!-- table-responsive ensures touch-swiping on small screens -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Ticker</th>
                                <th>Company</th>
                                <th>Price</th>
                                <th>Intrisic Value</th>
                                <th>Margin Of Safety</th>
                                <th>Sector</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Results.Any())
                            {
                                foreach (var stock in Model.Results)
                                {
                                    <tr>
                                        <td class="fw-bold text-primary">@stock.Ticker</td>
                                        <td>@stock.CompanyName</td>
                                        <td>@stock.Price.ToString("C")</td>
                                        <td>@stock.IntrinsicValue</td>
                                        <td>@stock.MarginOfSafety</td>
                                        <td><span class="badge bg-secondary">@stock.Sector</span></td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">No stocks match your active filter criteria.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    </div>
</div>
