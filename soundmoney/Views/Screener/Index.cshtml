@model SoundMoney.Models.ScreenerViewModel
@{
    ViewData["Title"] = "Screener";
}

<form method="get" class="row g-3 align-items-end mb-4">
    <div class="col-auto">
        <label class="form-label">Min. Margin of Safety (%)</label>
        <input type="number" name="minMarginOfSafety" value="@Model.MinMarginOfSafety" class="form-control" step="1" />
    </div>
    <div class="col-auto">
        <label class="form-label">Sector</label>
        <select name="sector" class="form-select">
            <option value="">All sectors</option>
            @foreach (var s in Enum.GetValues<SoundMoney.Models.SectorCategory>())
            {
                <option value="@s" selected="@(Model.SelectedSector == s)">@s</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Run screen</button>
    </div>
</form>

@if (!Model.Results.Any())
{
    <div class="alert alert-info">
        No stocks matched. This can mean either nothing clears your margin-of-safety
        threshold right now, or a symbol is missing fundamentals in
        <code>App_Data/fundamentals.csv</code> / its market quote failed to load
        (check the application log).
    </div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Symbol</th>
                <th>Company</th>
                <th>Sector</th>
                <th class="text-end">Current Price (₹)</th>
                <th class="text-end">Intrinsic Value (₹)</th>
                <th class="text-end">Margin of Safety</th>
                <th>Verdict</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Results)
            {
                <tr>
                    <td><strong>@row.Symbol</strong></td>
                    <td>@row.CompanyName</td>
                    <td>@row.Sector</td>
                    <td class="text-end">@row.CurrentPrice.ToString("N2")</td>
                    <td class="text-end">@row.IntrinsicValue.ToString("N2")</td>
                    <td class="text-end">@row.MarginOfSafetyPercent.ToString("N2")%</td>
                    <td>
                        <span class="badge @(row.Verdict == "Undervalued" ? "bg-success" : row.Verdict == "Overvalued" ? "bg-danger" : "bg-secondary")">
                            @row.Verdict
                        </span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<p class="text-muted small">
    Intrinsic value is calculated with a sector-specific model (banking uses a justified
    Price/Book approach, IT services and other sectors use growth-adjusted Graham
    formulas). Margin of Safety = (Intrinsic Value − Current Price) / Intrinsic Value.
    This is a screening tool, not investment advice — verify inputs before acting on them.
</p>
