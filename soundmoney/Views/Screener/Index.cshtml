@model SoundMoney.Models.ScreenerViewModel
@{
    ViewData["Title"] = "Screener";
}

<div class="container-fluid px-2 px-md-4 py-3">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h2 class="h4 mb-0 font-weight-bold">Stock Screener</h2>
    </div>

    <!-- Filter Form -->
    <div class="card border-0 shadow-sm mb-4 bg-light">
        <div class="card-body p-3">
            <form method="get" class="row g-2 g-md-3 align-items-end">
                <div class="col-12 col-sm-6 col-md-4">
                    <label class="form-label small text-muted font-weight-bold">Search Symbol or Company</label>
                    <input type="text" name="searchQuery" value="@Model.SearchQuery" class="form-control form-control-sm" placeholder="e.g. INFY, TCS, Wipro..." />
                </div>
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small text-muted font-weight-bold">Min. Margin of Safety (%)</label>
                    <input type="number" name="minMarginOfSafety" value="@Model.MinMarginOfSafety" class="form-control form-control-sm" step="1" />
                </div>

                <!-- Multi-Check Score Filter (Zero-JS Native Dropdown) -->
                <div class="col-12 col-sm-6 col-md-3">
                    <label class="form-label small text-muted font-weight-bold d-block">Score Filter</label>
                    <details class="custom-multi-select position-relative">
                        <summary class="btn btn-white border bg-white text-start text-truncate btn-sm d-flex justify-content-between align-items-center w-100">
                            <span id="scoreDropdownLabel">
                                @(Model.SelectedScores != null && Model.SelectedScores.Any()
                                                                ? string.Join(", ", Model.SelectedScores)
                                                                : "All scores")
                            </span>
                            <span class="ms-2 text-muted small">▼</span>
                        </summary>
                        <div class="card border shadow-sm p-2 position-absolute start-0 w-100 mt-1 bg-white" style="z-index: 1050; max-height: 200px; overflow-y: auto;">
                            @foreach (var s in new List<string>() { "STRONG SOUND", "SOUND", "NEUTRAL", "UNSOUND" })
                            {
                                bool isChecked = Model.SelectedScores != null && Model.SelectedScores.Contains(s);
                                <div class="form-check my-1">
                                    <input class="form-check-input score-checkbox"
                                           type="checkbox"
                                           name="scores"
                                           value="@s"
                                           id="score_@s.Replace(" ", "_")"
                                           @(isChecked ? "checked" : "") />
                                    <label class="form-check-label small w-100 cursor-pointer" for="score_@s.Replace(" ", "_")">
                                        @s
                                    </label>
                                </div>
                            }
                        </div>
                    </details>
                </div>

                <div class="col-12 col-md-2 d-grid">
                    <button type="submit" class="btn btn-primary btn-sm">Run Screen</button>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Results.Any())
    {
        <div class="alert alert-info border-0 shadow-sm">
            No stocks matched your search criteria. Try adjusting your search parameters.
        </div>
    }
    else
    {
        <!-- DESKTOP VIEW (Table) -->
        <div class="d-none d-md-block card border-0 shadow-sm mb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Symbol</th>
                            <th>Company</th>
                            <th>Sector</th>
                            <th class="text-end">Current Price (₹)</th>
                            <th class="text-end">Intrinsic Value (₹)</th>
                            <th class="text-end">Margin of Safety</th>
                            <th class="text-center">Verdict</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Results)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border font-monospace fs-6">@row.Symbol</span></td>
                                <td class="fw-semibold">@row.CompanyName</td>
                                <td><span class="badge bg-light text-secondary border fw-normal">@row.Sector</span></td>
                                <td class="text-end font-monospace">₹@row.CurrentPrice.ToString("N2")</td>
                                <td class="text-end font-monospace">₹@row.IntrinsicValue.ToString("N2")</td>
                                <td class="text-end font-monospace fw-bold @(row.MarginOfSafetyPercent >= 0 ? "text-success" : "text-danger")">
                                    @row.MarginOfSafetyPercent.ToString("N2")%
                                </td>
                                <td class="text-center">
                                    <span class="badge @(row.Verdict == "Undervalued" ? "bg-success" : row.Verdict == "Overvalued" ? "bg-danger" : "bg-secondary") me-1">
                                        @row.Verdict
                                    </span>
                                    <span class="badge bg-primary">
                                        @row.SoundScoreRating
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- MOBILE VIEW (Cards) -->
        <div class="d-md-none row g-3 mb-4">
            @foreach (var row in Model.Results)
            {
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge bg-light text-dark border font-monospace fs-6 me-1">@row.Symbol</span>
                                </div>
                                <div>
                                    <span class="badge @(row.Verdict == "Undervalued" ? "bg-success" : row.Verdict == "Overvalued" ? "bg-danger" : "bg-secondary")">
                                        @row.Verdict
                                    </span>
                                    <span class="badge bg-primary">
                                        @row.SoundScoreRating
                                    </span>
                                </div>
                            </div>

                            <h6 class="fw-bold mb-1">@row.CompanyName</h6>
                            <div class="mb-3">
                                <span class="badge bg-light text-secondary border fw-normal small">@row.Sector</span>
                            </div>

                            <div class="row g-2 text-center bg-light p-2 rounded mb-2 font-monospace small">
                                <div class="col-4 border-end">
                                    <span class="text-muted d-block small">Price</span>
                                    <strong>₹@row.CurrentPrice.ToString("N2")</strong>
                                </div>
                                <div class="col-4 border-end">
                                    <span class="text-muted d-block small">Intrinsic</span>
                                    <strong>₹@row.IntrinsicValue.ToString("N2")</strong>
                                </div>
                                <div class="col-4">
                                    <span class="text-muted d-block small">MoS</span>
                                    <strong class="@(row.MarginOfSafetyPercent >= 0 ? "text-success" : "text-danger")">
                                        @row.MarginOfSafetyPercent.ToString("N2")%
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <!-- Methodology Disclosure -->
    <div class="card border-0 bg-light p-3">
        <p class="text-muted small mb-0">
            <strong>Methodology & Disclaimer:</strong> Intrinsic value is calculated dynamically using sector-specific valuation models, applying a justified Price-to-Book or Excess Returns approach for financial institutions and cash-flow or growth-adjusted models like Owner Earnings, DCF, and relative multiples for non-financial sectors. The Margin of Safety is calculated as $\frac{\text{Intrinsic Value} - \text{Current Price}}{\text{Current Price}} \times 100\%$. Designed strictly for educational and screening purposes—always verify inputs before making investment decisions.
        </p>
    </div>
</div>