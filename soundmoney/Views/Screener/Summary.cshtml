@model SoundMoney.Models.StockDetailsViewModel
@using System.Linq
@{
    ViewData["Title"] = $"{Model.Symbol} - Simple Summary";
    var (bottomLine, sentiment) = Model.GetBottomLineSummary();
    var tally = Model.GetSignalTally();
    var sentimentBorder = sentiment == "Positive" ? "border-success" : sentiment == "Negative" ? "border-danger" : "border-warning";
    var sentimentBg = sentiment == "Positive" ? "bg-success-subtle" : sentiment == "Negative" ? "bg-danger-subtle" : "bg-warning-subtle";
}

<style>
    .extra-small { font-size: 0.8rem !important; }
    .signal-count { font-size: 1.75rem; font-weight: 700; line-height: 1; }
    .headline-card { background-color: #f8f9fa; border-radius: 0.5rem; padding: 1rem; height: 100%; }
</style>

<div class="container px-2 px-md-4 py-3" style="max-width: 900px;">
    <!-- Navigation -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Back to Screener</a>
        <a asp-action="Details" asp-route-symbol="@Model.Symbol" class="btn btn-outline-primary btn-sm">
            View Full Technical Analysis &rarr;
        </a>
    </div>

    <!-- Header -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-1">
                        <span class="badge bg-dark text-white font-monospace fs-6">@Model.Symbol</span>
                        <span class="badge bg-light text-secondary border">@Model.Sector</span>
                    </div>
                    <h3 class="fw-bold mb-0">@Model.CompanyName</h3>
                </div>
                <div class="text-md-end">
                    <span class="text-muted small d-block">Current Price</span>
                    <h2 class="fw-bold text-primary mb-0">₹@Model.CurrentPrice.ToString("N2")</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Line -->
    <div class="card border-2 @sentimentBorder shadow-sm mb-3">
        <div class="card-body p-3 p-md-4 @sentimentBg bg-opacity-25">
            <h5 class="fw-bold mb-2">In Plain English</h5>
            <p class="mb-3" style="font-size: 1.05rem;">@bottomLine</p>

            <div class="row g-2 text-center mb-2">
                <div class="col-4">
                    <div class="signal-count text-success">@tally.Positive</div>
                    <span class="extra-small text-muted">Look Good</span>
                </div>
                <div class="col-4">
                    <div class="signal-count text-warning-emphasis">@tally.Caution</div>
                    <span class="extra-small text-muted">Worth a Look</span>
                </div>
                <div class="col-4">
                    <div class="signal-count text-danger">@tally.Negative</div>
                    <span class="extra-small text-muted">A Concern</span>
                </div>
            </div>
            <p class="extra-small text-muted mb-0 text-center">
                Based on @tally.Total signals checked on this stock@(tally.NotApplicable > 0 ? $" ({tally.NotApplicable} don't apply to this company)" : "").
            </p>
        </div>
    </div>

    <!-- Verdict + Score -->
    <div class="row g-3 mb-3">
        <div class="col-6">
            <div class="card border-0 shadow-sm text-center p-3 h-100">
                <span class="text-muted small">Is it cheap or expensive?</span>
                <span class="badge fs-5 mt-2 @(Model.Verdict == "STRONG BUY" || Model.Verdict == "BUY" ? "bg-success" : Model.Verdict == "OVERVALUED" ? "bg-danger" : "bg-warning text-dark")">
                    @Model.Verdict
                </span>
                <span class="extra-small text-muted mt-2">
                    Estimated to be worth about ₹@Model.IntrinsicValue.ToString("N2") per share
                </span>
            </div>
        </div>
        <div class="col-6">
            <div class="card border-0 shadow-sm text-center p-3 h-100">
                <span class="text-muted small">How financially healthy is it?</span>
                <span class="badge fs-5 mt-2 @(Model.SoundScoreRating == "STRONG SOUND" || Model.SoundScoreRating == "SOUND" ? "bg-primary" : Model.SoundScoreRating == "UNSOUND" ? "bg-danger" : "bg-secondary")">
                    @Model.SoundScoreRating
                </span>
                <span class="extra-small text-muted mt-2">Score: @Model.SoundScore / 100</span>
            </div>
        </div>
    </div>

    <!-- Buy / Fair / Sell zone -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-3">
            <span class="small fw-bold text-muted d-block mb-2">What price would make this a good deal?</span>
            <div class="row text-center g-2">
                <div class="col-4">
                    <span class="badge bg-success mb-1">Attractive Below</span>
                    <div class="fw-bold fs-5">₹@Model.StrongBuyBelowPrice.ToString("N2")</div>
                </div>
                <div class="col-4">
                    <span class="badge bg-info text-dark mb-1">Fair Value</span>
                    <div class="fw-bold fs-5">₹@Model.IntrinsicValue.ToString("N2")</div>
                </div>
                <div class="col-4">
                    <span class="badge bg-danger mb-1">Pricey Above</span>
                    <div class="fw-bold fs-5">₹@Model.SellAbovePrice.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Key questions, answered in plain English instead of shown as raw ratios -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white border-0 py-3">
            <h6 class="fw-bold mb-0">Questions This Stock Answers</h6>
            <span class="extra-small text-muted">A full stock-analysis checklist, in plain English</span>
        </div>
        <div class="card-body pt-0">
            @foreach (var group in Model.GetKeyQuestions().GroupBy(q => q.Category))
            {
                <h6 class="text-muted text-uppercase extra-small fw-bold mt-3 mb-2">@group.Key</h6>
                <div class="row g-2 mb-2">
                    @foreach (var qa in group)
                    {
                        <div class="col-12">
                            <div class="headline-card d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2">
                                <div>
                                    <span class="fw-semibold d-block">@qa.Question</span>
                                    @if (!string.IsNullOrEmpty(qa.SupportingFact))
                                    {
                                        <span class="extra-small text-muted">@qa.SupportingFact</span>
                                    }
                                </div>
                                <span class="badge @qa.CssClass flex-shrink-0">@qa.Answer</span>
                            </div>
                        </div>
                    }
                </div>
            }
            <p class="extra-small text-muted mt-2 mb-0">
                Last updated: @(Model.LastAnalyzed.HasValue ? Model.LastAnalyzed.Value.ToString("dd MMM yyyy") : "N/A")
            </p>
        </div>
    </div>

    <!-- Disclaimer -->
    <div class="card border-0 bg-light p-3 mb-3">
        <p class="text-muted extra-small mb-0">
            This page summarizes the same data and calculations shown on the Full Technical Analysis page, in plain language, for general education only - it is not investment advice. Always verify independently before making any investment decision.
        </p>
    </div>
</div>
